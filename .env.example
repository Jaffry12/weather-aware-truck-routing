# Backend (Django). None of these are required for local development.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173
API_RATE_LIMIT=60/min

# Upstream providers (all free, no keys)
OSRM_URL=https://router.project-osrm.org
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
PHOTON_URL=https://photon.komoot.io/api/

# Frontend (Vite). Leave empty to call the same origin (/api).
VITE_API_BASE=
